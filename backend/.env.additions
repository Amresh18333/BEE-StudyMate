# ---- Add these lines to your backend .env ----

# Which model writes the PDF summaries:
#   NVIDIA       = hosted NVIDIA API (default; needs NVIDIA_API_KEY)
#   OLLAMA_QWEN  = Qwen running on your own computer through Ollama
SUMMARIZER_PROVIDER=NVIDIA

# Only used when SUMMARIZER_PROVIDER=OLLAMA_QWEN
OLLAMA_BASE_URL=http://localhost:11434/v1
# "studymate-qwen" = the model name you create with the Modelfiles in the ollama folder
OLLAMA_MODEL=studymate-qwen
# Seconds to wait for one section. Raise it if your computer has no GPU.
OLLAMA_TIMEOUT_SECONDS=900
